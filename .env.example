PORT=8787
# Set STATE_DIR=/var/data when a cloud provider mounts a persistent disk.
STATE_DIR=
MONITOR_INTERVAL_SECONDS=60
# Add an X API v2 Bearer Token to enable live X monitoring.
X_BEARER_TOKEN=
# Example: ("quiet luxury" OR "first car") lang:en -is:retweet
X_SEARCH_QUERY=
# Optional OpenAI-compatible model endpoint for real remix generation.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
